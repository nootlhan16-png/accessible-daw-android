<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Digital Audio Workstation"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:contentDescription="App Title"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to record"
        android:textSize="18sp"
        android:gravity="center"
        android:contentDescription="Status"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/recordBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔴 Record"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Start recording audio" />

    <Button
        android:id="@+id/playBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶️ Play"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Play recorded audio" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏹️ Stop"
        android:textSize="18sp"
        android:padding="16dp"
        android:contentDescription="Stop recording or playback" />

</LinearLayout>